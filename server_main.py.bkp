from flask import Flask, request
from datetime import datetime
import logging
import requests
from werkzeug.serving import WSGIRequestHandler

# =====================================================
# MÓDULOS
# =====================================================
from registrar_entrada import registrar_entrada
from registrar_gasto import registrar_gasto
#from registrar_cartao import registrar_cartao
from consultar_gastos import consultar_gastos

# =====================================================
# CONFIGURAÇÃO
# =====================================================

app = Flask(__name__)

GRUPO_FINANCEIRO = "120363427144812522@g.us"
URL_EVOLUTION = "http://localhost:8080/message/sendText/Financeiro"
APIKEY = "financeiro-casal-teto-para-dois-2026"

# =====================================================
# EVOLUTION
# =====================================================

def resposta_robo(texto: str) -> str:
    return f"🤖 *ROBO:*\n\n{texto}"


def enviar_mensagem(texto: str):

    headers = {
        "apikey": APIKEY,
        "Content-Type": "application/json"
    }

    payload = {
        "number": GRUPO_FINANCEIRO,
        "text": resposta_robo(texto)
    }

    try:
        requests.post(
            URL_EVOLUTION,
            json=payload,
            headers=headers,
            timeout=10
        )
    except Exception as erro:
        print("Erro ao enviar mensagem:", erro)


# =====================================================
# AUXILIARES
# =====================================================

def eh_mensagem_do_robo(texto: str) -> bool:

    if not texto:
        return False

    texto = texto.lower().strip()

    return (
        texto.startswith("🤖")
        or texto.startswith("robo:")
        or texto.startswith("*robo*")
        or texto.startswith("bot:")
        or texto.startswith("assistant:")
    )


def responder(funcao, *args):

    try:
        resposta = funcao(*args)

        if resposta:
            enviar_mensagem(resposta)

    except Exception as erro:
        print(erro)
        enviar_mensagem(f"❌ {erro}")


def converter_data(data_msg: str):

    try:
        return datetime.fromisoformat(
            data_msg.replace("Z", "+00:00")
        )
    except Exception:
        return datetime.now()


# =====================================================
# WEBHOOK
# =====================================================

@app.route("/webhook", methods=["POST"])
def webhook():

    dados = request.json

    if not dados:
        return "OK"

    if dados.get("event") != "messages.upsert":
        return "OK"

    data = dados.get("data", {})
    key = data.get("key", {})
    message = data.get("message", {})

    # Ignora mensagens técnicas do WhatsApp
    if "senderKeyDistributionMessage" in message:
        return "OK"

    # Apenas grupo financeiro
    if key.get("remoteJid") != GRUPO_FINANCEIRO:
        return "OK"

    # Apenas mensagens de texto
    if "conversation" not in message:
        return "OK"

    mensagem_raw = message.get("conversation", "").strip()

    # Ignora respostas do próprio robô
    if eh_mensagem_do_robo(mensagem_raw):
        return "OK"

    mensagem = mensagem_raw.lower()

    pessoa = data.get("pushName", "Desconhecido")

    data_convertida = converter_data(
        dados.get("date_time", "")
    )

    print("\n" + "=" * 60)
    print("Mensagem :", mensagem_raw)
    print("Pessoa   :", pessoa)
    print("ID       :", key.get("id"))
    print("=" * 60)

    # =====================================================
    # TESTE
    # =====================================================

    if mensagem == "teste":
        enviar_mensagem("✅ Sistema funcionando!")
        return "OK"

    # =====================================================
    # HELP
    # =====================================================

    if mensagem in ("help", "ajuda"):

        enviar_mensagem(
            "*Comandos disponíveis*\n\n"
            "• teste\n"
            "• help\n"
            "• gasto\n"
            "• entrada\n"
            "• cartao\n"
            "• extrato\n"
            "• divida"
        )

        return "OK"

    if mensagem.startswith("help ") or mensagem.startswith("ajuda "):

        if "gasto" in mensagem:

            enviar_mensagem(
                "*gasto <valor> <descrição>*\n\n"
                "Exemplo:\n"
                "gasto mercado 150"
            )

        elif "entrada" in mensagem:

            enviar_mensagem(
                "*entrada <origem> <valor> <descrição>*\n\n"
                "Exemplo:\n"
                "entrada salario 2500"
            )

        elif "cartao" in mensagem:

            enviar_mensagem(
                "*cartao <descrição> <valor> <parcelas>*\n\n"
                "Exemplo:\n"
                "cartao celular 1800 12"
            )

        elif "extrato" in mensagem:

            enviar_mensagem(
                "*extrato*\n\n"
                "extrato\n"
                "extrato anterior"
            )

        elif "divida" in mensagem:

            enviar_mensagem(
                "*divida <valor> <descrição>*\n\n"
                "Registra uma dívida.\n\n"
                "Exemplos:\n"
                "divida 350 joao\n"
                "divida 850 oficina"
            )

        else:

            enviar_mensagem(
                "Comando não encontrado."
            )

        return "OK"

    # =====================================================
    # GASTO
    # =====================================================

    if mensagem.startswith("gasto"):

        responder(
            registrar_gasto,
            mensagem_raw,
            pessoa,
            data_convertida
        )

        return "OK"

    # =====================================================
    # ENTRADA
    # =====================================================

    if mensagem.startswith("entrada"):

        responder(
            registrar_entrada,
            mensagem_raw,
            pessoa,
            data_convertida
        )

        return "OK"

    # =====================================================
    # CARTÃO
    # =====================================================

    if mensagem.startswith("cartao"):

        responder(
            registrar_cartao,
            mensagem_raw,
            pessoa,
            data_convertida
        )

        return "OK"

    # =====================================================
    # EXTRATO
    # =====================================================

    if mensagem.startswith("extrato"):

        try:

            mes = data_convertida.month
            ano = data_convertida.year

            if "anterior" in mensagem:

                mes -= 1

                if mes == 0:
                    mes = 12
                    ano -= 1

            enviar_mensagem(
                consultar_gastos(mes, ano)
            )

        except Exception as erro:

            print(erro)
            enviar_mensagem(
                "❌ Erro ao gerar o extrato."
            )

        return "OK"

    return "OK"


# =====================================================
# MAIN
# =====================================================

if __name__ == "__main__":

    WSGIRequestHandler.log_request = lambda *args, **kwargs: None
    logging.getLogger("werkzeug").setLevel(logging.ERROR)

    print("=" * 60)
    print("🤖 BOT FINANCEIRO")
    print("Grupo :", GRUPO_FINANCEIRO)
    print("Porta : 5000")
    print("=" * 60)

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=True,
        use_reloader=False
    )